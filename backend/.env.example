# Copy this file to .env and fill in what you use.

PORT=8080

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Optional: bot tokens for the Interface layer (only needed once you connect a channel)
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Individual LLM node API keys are stored per-node in the database via the UI,
# NOT here. This file is only for interface/channel credentials and server config.
